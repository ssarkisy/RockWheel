# Neo: the status line and the main menu's pane. Made by themes/tools/make_neo_theme.py
%wd
%Fl(2,15-Inter-Medium.fnt)
%Fl(3,15-Inter-SemiBold.fnt)
%Fl(4,15-Inter-Regular.fnt)
%xl(B,Battery.bmp,0,0,24)
%xl(P,Playing Status.bmp,0,0,4)
%xl(H,Hold.bmp,0,0)
%xl(N,Night.bmp,0,0)
%?LW<%VI(wide)%Vd(rulewide)%Vd(clockwide)%Vd(titlewide)%Vd(bat)%?nN<%Vd(moon)%Vd(playn1)|%Vd(playn0)>|%VI(half)%Vd(rulehalf)%Vd(column)%Vd(name)%Vd(hbat)%?nN<%Vd(hmoon)%Vd(hplayn1)|%Vd(hplayn0)>>
# the pane by the row selected: Settings, Extras, Photos, or the music
%?LW<|%?LS<%Vd(surface)%Vd(ring)%Vd(about)|%Vd(surface)%Vd(dial)%Vd(extras)|%Vd(surface)%?nP<%Vd(collage)%Vd(photocount)|%Vd(nophotos)%Vd(photocaption)>|%?C<%Vd(a)|%Vd(surface)%Vd(note)%?mp<%Vd(stopped)|%Vd(normal)|%Vd(normal)|%Vd(normal)|%Vd(normal)|%Vd(normal)|%Vd(normal)|%Vd(stopped)|%Vd(stopped)>>>>
# the cover fills the pane, nothing over it: Finder's 240 px frame, its middle 160
%Cl(0,0,240,240,c,c)
%Vl(a,120,0,200,240,-)
%Cd
%Vl(a,120,0,40,240,-)
# the lists: under the status line's 22 px and its hairline, rows of 30; beside
# the pane 156 wide, so that the selected row ends at 150
%Vi(wide,0,34,320,194,1)%Vf(EFEBE7)%Vb(211C18)
%Vi(half,0,34,156,194,1)%Vf(EFEBE7)%Vb(211C18)
# hairlines: row 22 under the status line, over the menu only beside the pane,
# and column 159 between the menu and the pane
%Vl(rulewide,0,22,320,1,-)%Vb(313029)
%Vl(rulehalf,0,22,159,1,-)%Vb(313029)
%Vl(column,159,0,1,240,-)%Vb(313029)
# a screen that takes the whole width: the clock, its title, the glyphs
%Vl(clockwide,16,4,64,15,2)%Vf(A59E94)
%al%?cf<%cH:%cM|%cl:%cM>
%Vl(titlewide,84,4,152,15,3)%Vf(EFEBE7)
%s%ac%Lt
%Vl(bat,285,6,19,10,-)
%?bp<%?bc<%t(1.0)%xd(Ba);%t(1.0)%xd(Bb)|%xd(Bc)>|%?bl<%xd(Bd)|%xd(Bd)|%xd(Be)|%xd(Bf)|%xd(Bg)|%xd(Bh)|%xd(Bi)|%xd(Bj)|%xd(Bk)|%xd(Bl)|%xd(Bm)|%xd(Bn)|%xd(Bo)|%xd(Bp)|%xd(Bq)|%xd(Br)|%xd(Bs)|%xd(Bt)|%xd(Bu)|%xd(Bv)|%xd(Bw)|%xd(Bx)|%xd(Bx)|%xd(Bx)>>
%Vl(playn0,271,6,8,10,-)
%?mh<%xd(H)|%?mp<|%xd(Pa)|%xd(Pb)|%xd(Pc)|%xd(Pd)>>
%Vl(moon,269,6,10,10,-)
%xd(N)
%Vl(playn1,255,6,8,10,-)
%?mh<%xd(H)|%?mp<|%xd(Pa)|%xd(Pb)|%xd(Pc)|%xd(Pd)>>
# beside the pane: the name given in Finder in the main menu, a menu's title
%Vl(name,16,4,84,15,3)%Vf(EFEBE7)
%al%?if(%Li, =, 33)<%nn|%s%Lt>
%Vl(hbat,125,6,19,10,-)
%?bp<%?bc<%t(1.0)%xd(Ba);%t(1.0)%xd(Bb)|%xd(Bc)>|%?bl<%xd(Bd)|%xd(Bd)|%xd(Be)|%xd(Bf)|%xd(Bg)|%xd(Bh)|%xd(Bi)|%xd(Bj)|%xd(Bk)|%xd(Bl)|%xd(Bm)|%xd(Bn)|%xd(Bo)|%xd(Bp)|%xd(Bq)|%xd(Br)|%xd(Bs)|%xd(Bt)|%xd(Bu)|%xd(Bv)|%xd(Bw)|%xd(Bx)|%xd(Bx)|%xd(Bx)>>
%Vl(hplayn0,111,6,8,10,-)
%?mh<%xd(H)|%?mp<|%xd(Pa)|%xd(Pb)|%xd(Pc)|%xd(Pd)>>
%Vl(hmoon,109,6,10,10,-)
%xd(N)
%Vl(hplayn1,95,6,8,10,-)
%?mh<%xd(H)|%?mp<|%xd(Pa)|%xd(Pb)|%xd(Pc)|%xd(Pd)>>
