# Neo: the status line and the main menu's pane. Made by themes/tools/make_neo_theme.py
%wd
%Fl(2,15-Inter-Medium.fnt)
%Fl(3,15-Inter-SemiBold.fnt)
%xl(B,Battery.bmp,0,0,24)
%xl(P,Playing Status.bmp,0,0,4)
%xl(H,Hold.bmp,0,0)
%xl(N,Night.bmp,0,0)
%?LW<%VI(wide)%Vd(rulewide)%Vd(clockwide)%Vd(titlewide)%Vd(bat)%?nN<%Vd(moon)%Vd(playn1)|%Vd(playn0)>|%VI(half)%Vd(rulehalf)%Vd(column)%Vd(hbat)%?nN<%Vd(hmoon)%Vd(hplayn1)%?if(%Li, =, 33)<%Vd(hclock)|%Vd(hnamen1)>|%Vd(hplayn0)%?if(%Li, =, 33)<%Vd(hclock)|%Vd(hnamen0)>>>
# the pane by the row selected: Settings, Photos, or the music, which Extras has too
%?LW<|%?LS<%Vd(surface)%Vd(ring)%Vd(about)|%?C<%Vd(a)|%Vd(surface)%Vd(note)%?mp<%Vd(stopped)|%Vd(normal)|%Vd(normal)|%Vd(normal)|%Vd(normal)|%Vd(normal)|%Vd(normal)|%Vd(stopped)|%Vd(stopped)>>|%Vd(surface)%?nP<%Vd(collage)%Vd(photocount)|%Vd(nophotos)%Vd(photocaption)>|%?C<%Vd(a)|%Vd(surface)%Vd(note)%?mp<%Vd(stopped)|%Vd(normal)|%Vd(normal)|%Vd(normal)|%Vd(normal)|%Vd(normal)|%Vd(normal)|%Vd(stopped)|%Vd(stopped)>>>>
# the cover fills the pane, nothing over it: Finder's 240 px frame, its middle 160
%Cl(0,0,240,240,c,c)
%Vl(a,120,0,200,240,-)
%Cd
%Vl(a,120,0,40,240,-)
# the lists: under the status line and its hairline, rows of 30; beside the
# pane 156 wide, so that the selected row ends at 150
%Vi(wide,0,23,320,216,1)%Vf(EFEBE7)%Vb(211C18)
%Vi(half,0,23,156,216,1)%Vf(EFEBE7)%Vb(211C18)
# hairlines: under the status line, over the menu only beside the pane, and
# column 159 between the menu and the pane
%Vl(rulewide,0,20,320,1,-)%Vb(313029)
%Vl(rulehalf,0,20,159,1,-)%Vb(313029)
%Vl(column,159,0,1,240,-)%Vb(313029)
# a screen that takes the whole width: the clock, its title, the glyphs
%Vl(clockwide,14,2,64,15,3)%Vf(B5AEA5)
%al%?cf<%cH:%cM|%cl:%cM>
%Vl(titlewide,84,2,152,15,3)%Vf(EFEBE7)
%s%ac%Lt
%Vl(bat,287,4,19,10,-)
%?bp<%?bc<%t(1.0)%xd(Ba);%t(1.0)%xd(Bb)|%xd(Bc)>|%?bl<%xd(Bd)|%xd(Bd)|%xd(Be)|%xd(Bf)|%xd(Bg)|%xd(Bh)|%xd(Bi)|%xd(Bj)|%xd(Bk)|%xd(Bl)|%xd(Bm)|%xd(Bn)|%xd(Bo)|%xd(Bp)|%xd(Bq)|%xd(Br)|%xd(Bs)|%xd(Bt)|%xd(Bu)|%xd(Bv)|%xd(Bw)|%xd(Bx)|%xd(Bx)|%xd(Bx)>>
%Vl(playn0,273,4,8,10,-)
%?mh<%xd(H)|%?mp<|%xd(Pa)|%xd(Pb)|%xd(Pc)|%xd(Pd)>>
%Vl(moon,271,4,10,10,-)
%xd(N)
%Vl(playn1,257,4,8,10,-)
%?mh<%xd(H)|%?mp<|%xd(Pa)|%xd(Pb)|%xd(Pc)|%xd(Pd)>>
# beside the pane: the clock in the main menu, where a screen of the whole
# width has it; a menu's title in any other
%Vl(hclock,14,2,64,15,3)%Vf(B5AEA5)
%al%?cf<%cH:%cM|%cl:%cM>
%Vl(hbat,127,4,19,10,-)
%?bp<%?bc<%t(1.0)%xd(Ba);%t(1.0)%xd(Bb)|%xd(Bc)>|%?bl<%xd(Bd)|%xd(Bd)|%xd(Be)|%xd(Bf)|%xd(Bg)|%xd(Bh)|%xd(Bi)|%xd(Bj)|%xd(Bk)|%xd(Bl)|%xd(Bm)|%xd(Bn)|%xd(Bo)|%xd(Bp)|%xd(Bq)|%xd(Br)|%xd(Bs)|%xd(Bt)|%xd(Bu)|%xd(Bv)|%xd(Bw)|%xd(Bx)|%xd(Bx)|%xd(Bx)>>
%Vl(hplayn0,113,4,8,10,-)
%?mh<%xd(H)|%?mp<|%xd(Pa)|%xd(Pb)|%xd(Pc)|%xd(Pd)>>
%Vl(hnamen0,14,2,93,15,3)%Vf(EFEBE7)
%al%s%Lt
%Vl(hmoon,111,4,10,10,-)
%xd(N)
%Vl(hplayn1,97,4,8,10,-)
%?mh<%xd(H)|%?mp<|%xd(Pa)|%xd(Pb)|%xd(Pc)|%xd(Pd)>>
%Vl(hnamen1,14,2,77,15,3)%Vf(EFEBE7)
%al%s%Lt
# the pane without a cover: a surface, and on it by the row
%Vl(surface,160,0,160,240,-)%Vb(312C29)
# Settings: the disk's use as a ring round (240, 96), the used part in the
# second grey over a track of the ground's colour; what is free, and the whole
%Vl(ring,200,56,80,80,-)%Vf(A59E94)%Vb(312C29)
%nR
%Vl(about,160,157,160,19,1)%Vf(EFEBE7)%Vb(312C29)
%s%ac%nf
%Vl(about,160,180,160,15,2)%Vf(B5B2A5)%Vb(312C29)
%ac%nT
%Vl(collage,160,0,160,176,-)%Vb(312C29)
%xl(Q,/.rockbox/photos_panel.bmp,0,0)
%xd(Q)
%Vl(photocount,160,200,160,15,2)%Vf(B5B2A5)%Vb(312C29)
%s%ac%nP
# no photos: their mark, a mask in the note's two colours as the note is
%xl(I,Photos Pane.bmp,0,0)
%xN(I)
%Vl(nophotos,212,82,56,44,-)%Vb(312C29)
%xd(I)
%Vl(photocaption,160,160,160,15,2)%Vf(B5B2A5)%Vb(312C29)
%ac%nP
# nothing playing, or a track without a cover: the note, and under it the
# library's count or the track. A note is its mask, drawn in the theme's two
# colours for it (%xN), which take the theme's tone as the surfaces do
%xl(O,Note Pane.bmp,0,0)
%xN(O)
%Vl(note,198,62,84,84,-)%Vb(312C29)
%xd(O)
%Vl(stopped,160,160,160,15,2)%Vf(B5B2A5)%Vb(312C29)
%ac%ns
%Vl(normal,168,160,144,15,2)%Vf(B5B2A5)%Vb(312C29)
%s%ac%?it<%it|%?fn<%fn|>>
