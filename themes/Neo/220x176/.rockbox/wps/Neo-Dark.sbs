%Vl(hnamen0p,4,2,65,14,3)%Vf(EFEBE7)
%al%nx%Lt
%Vl(hnamen0,4,2,78,14,3)%Vf(EFEBE7)
%al%nx%Lt
%Vl(hmoon,72,3,10,10,-)
%xd(N)
%Vl(hplayn1,59,3,8,10,-)
%?mh<%xd(H)|%?mp<|%xd(Pa)|%xd(Pb)|%xd(Pc)|%xd(Pd)>>
%Vl(hnamen1p,4,2,50,14,3)%Vf(EFEBE7)
%al%nx%Lt
%Vl(hnamen1,4,2,63,14,3)%Vf(EFEBE7)
%al%nx%Lt
# the pane's surface, under all but a cover
%Vl(surface,110,0,110,176,-)%Vb(312C29)
# Settings: the disk's use as a ring of 64 px (neo_ring.h), the used part
# in the second grey over a track of the ground's colour; what is free, and
# the whole, one block in the middle of the pane
%Vl(ring,133,36,64,64,-)%Vf(A59E94)%Vb(312C29)
%nR
%Vl(about,113,110,104,14,3)%Vf(EFEBE7)%Vb(312C29)
%s%ac%nf
%Vl(about,113,126,104,14,2)%Vf(B5B2A5)%Vb(312C29)
%ac%nT
# Photos: four rows of three of them, made at Updating Library
# (photos_panel.c), round and between which the pane shows, and their count
# under them; without any, their mark and "No Photos"
%Vl(collage,110,12,110,132,-)%Vb(312C29)
%xl(Q,/.rockbox/photos_panel.bmp,0,0)
%xd(Q)
%Vl(photocount,113,150,104,14,2)%Vf(B5B2A5)%Vb(312C29)
%s%ac%nP
%xl(I,Photos Pane.bmp,0,0)
%xN(I)
%Vl(nophotos,137,53,56,44,-)%Vb(312C29)
%xd(I)
%Vl(photocaption,113,109,104,14,2)%Vf(B5B2A5)%Vb(312C29)
%ac%nP
# the music without a cover: the note, a mask drawn in the theme's two
# colours for it (%xN), which take the theme's tone as the surfaces do, and
# under it the library's count or the track
%xl(O,Note Pane.bmp,0,0)
%xN(O)
%Vl(note,123,33,84,84,-)%Vb(312C29)
%xd(O)
%Vl(stopped,110,129,110,14,2)%Vf(B5B2A5)%Vb(312C29)
