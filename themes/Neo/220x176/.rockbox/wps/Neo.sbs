%Vl(hclock,10,2,48,14,3)%Vf(524D4A)
%al%?cf<%cH:%cM|%cl:%cM>
%Vl(hbat,81,3,19,10,-)
%?bp<%?bc<%t(1.0)%xd(Ba);%t(1.0)%xd(Bb)|%xd(Bc)>|%?bl<%xd(Bd)|%xd(Bd)|%xd(Be)|%xd(Bf)|%xd(Bg)|%xd(Bh)|%xd(Bi)|%xd(Bj)|%xd(Bk)|%xd(Bl)|%xd(Bm)|%xd(Bn)|%xd(Bo)|%xd(Bp)|%xd(Bq)|%xd(Br)|%xd(Bs)|%xd(Bt)|%xd(Bu)|%xd(Bv)|%xd(Bw)|%xd(Bx)|%xd(Bx)|%xd(Bx)>>
%Vl(hplayn0,68,3,8,10,-)
%?mh<%xd(H)|%?mp<|%xd(Pa)|%xd(Pb)|%xd(Pc)|%xd(Pd)>>
%Vl(hnamen0p,10,2,53,14,3)%Vf(292421)
%al%nx%Lt
%Vl(hnamen0,10,2,66,14,3)%Vf(292421)
%al%nx%Lt
%Vl(hmoon,66,3,10,10,-)
%xd(N)
%Vl(hplayn1,53,3,8,10,-)
%?mh<%xd(H)|%?mp<|%xd(Pa)|%xd(Pb)|%xd(Pc)|%xd(Pd)>>
%Vl(hnamen1p,10,2,38,14,3)%Vf(292421)
%al%nx%Lt
%Vl(hnamen1,10,2,51,14,3)%Vf(292421)
