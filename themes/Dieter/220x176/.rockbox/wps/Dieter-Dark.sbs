%?LW<%VI(wide)%?St(battery percentage)<%?if(%Li, =, 33)<%Vd(clockwide)|%?nN<%?Lf(ptitlewide1)<%Vd(clockwide)%Vd(ptitlewide1)|%?Lf(proomwide1)<%Vd(clockwide)%Vd(proomwide1)|%?mh<%Vd(plongn1p)|%?mp<%Vd(plongn1)|%Vd(plongn1p)|%Vd(plongn1p)|%Vd(plongn1p)|%Vd(plongn1p)>>>>|%?Lf(ptitlewide0)<%Vd(clockwide)%Vd(ptitlewide0)|%?Lf(proomwide0)<%Vd(clockwide)%Vd(proomwide0)|%?mh<%Vd(plongn0p)|%?mp<%Vd(plongn0)|%Vd(plongn0p)|%Vd(plongn0p)|%Vd(plongn0p)|%Vd(plongn0p)>>>>>>%Vd(bat)%?nN<%Vd(ppct)%?if(%bl, <, 10)<%Vd(pmoon1)%Vd(pplayn11)|%?if(%bl, <, 100)<%Vd(pmoon2)%Vd(pplayn12)|%Vd(pmoon)%Vd(pplayn1)>>|%Vd(ppct)%?if(%bl, <, 10)<%Vd(pplayn01)|%?if(%bl, <, 100)<%Vd(pplayn02)|%Vd(pplayn0)>>>|%?if(%Li, =, 33)<%Vd(clockwide)|%?Lf(titlewide)<%Vd(clockwide)%Vd(titlewide)|%?nN<%?mh<%Vd(longn1p)|%?mp<%Vd(longn1)|%Vd(longn1p)|%Vd(longn1p)|%Vd(longn1p)|%Vd(longn1p)>>|%?mh<%Vd(longn0p)|%?mp<%Vd(longn0)|%Vd(longn0p)|%Vd(longn0p)|%Vd(longn0p)|%Vd(longn0p)>>>>>%Vd(bat)%?nN<%Vd(moon)%Vd(playn1)|%Vd(playn0)>>|%VI(half)%?St(battery percentage)<%Vd(hbat)%?nN<%?mh<%Vd(hphold)|%Vd(hpmoon)>%?if(%Li, =, 33)<%Vd(hpclock)|%?mh<%Vd(hpnameh)|%Vd(hpnamen1)>>|%?mh<%Vd(hphold)|%Vd(hppct)>%?if(%Li, =, 33)<%Vd(hpclock)|%?mh<%Vd(hpnameh)|%Vd(hpnamen0)>>>|%Vd(hbat)%?nN<%Vd(hmoon)%Vd(hplayn1)%?if(%Li, =, 33)<%Vd(hclock)|%?mh<%Vd(hnamen1p)|%?mp<%Vd(hnamen1)|%Vd(hnamen1p)|%Vd(hnamen1p)|%Vd(hnamen1p)|%Vd(hnamen1p)>>>|%Vd(hplayn0)%?if(%Li, =, 33)<%Vd(hclock)|%?mh<%Vd(hnamen0p)|%?mp<%Vd(hnamen0)|%Vd(hnamen0p)|%Vd(hnamen0p)|%Vd(hnamen0p)|%Vd(hnamen0p)>>>>>>
# the pane by the row selected: Settings' disk, Photos' collage, or the music
%?LW<|%?LS<%Vd(floor)%Vd(ring)%Vd(about)|%?C<%Vd(a)|%Vd(floor)%Vd(grille)%?mp<%Vd(stopped)|%Vd(normal)|%Vd(normal)|%Vd(normal)|%Vd(normal)|%Vd(normal)|%Vd(normal)|%Vd(stopped)|%Vd(stopped)>>|%Vd(floor)%?nP<%Vd(collage)%Vd(photocount)|%Vd(grille)%Vd(photocaption)>|%?C<%Vd(a)|%Vd(floor)%Vd(grille)%?mp<%Vd(stopped)|%Vd(normal)|%Vd(normal)|%Vd(normal)|%Vd(normal)|%Vd(normal)|%Vd(normal)|%Vd(stopped)|%Vd(stopped)>>>>
# the cover fills the pane, Finder's 176 px frame, its middle 110
# columns
%Cl(0,0,176,176,c,c)
%Vl(a,77,0,143,176,-)
%Cd
%Vl(a,77,0,33,176,-)
# the lists: under the status line, its hairline and its lip; beside the
# pane as wide as the list is to the pane's wall. The ground is the
# backdrop's (Dieter.bmp), lit from the top
%Vi(wide,0,16,220,160,1)%Vf(EFEFEF)%Vb(181818)
%Vi(half,0,16,110,160,1)%Vf(EFEFEF)%Vb(181818)
