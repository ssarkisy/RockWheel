# Modern: the status bar, and the main menu's pane or the lists of the
# screen's whole width. Made by themes/tools/make_modern_theme.py
%wd
%Fl(2,14-Inter-SemiBold.fnt)
%Fl(3,14-Inter-Medium.fnt)
%xl(B,Battery.bmp,0,0,24)
%xl(P,Playing Status.bmp,0,0,4)
%xl(H,Hold.bmp,1,0)
%xl(N,Night.bmp,0,0)
# beside the pane the bar is as wide as the menu: the clock and the glyphs;
# the pane has the screen's whole height
%?LW<%VI(wide)%Vd(bar)%Vd(rule)%?if(%Li, =, 33)<%Vd(clock)|%?Lf(title)<%Vd(clock)%Vd(title)|%?nN<%Vd(longm)|%?mh<%Vd(longp)|%?mp<%Vd(long)|%Vd(longp)|%Vd(longp)|%Vd(longp)|%Vd(longp)>>>>>%Vd(bat)%Vd(play)%?nN<%Vd(moon)>|%VI(half)%Vd(barh)%Vd(ruleh)%Vd(clock)%Vd(bath)%Vd(playh)%?nN<%Vd(moonh)>>
# the pane by the row selected: Settings, Photos, or the music, which Extras
# has too
%?LW<|%?LS<%Vd(pane)%Vd(ring)%Vd(about)|%?C<%Vd(a)|%Vd(pane)%Vd(note)%?mp<%Vd(stopped)|%Vd(normal)|%Vd(normal)|%Vd(normal)|%Vd(normal)|%Vd(normal)|%Vd(normal)|%Vd(stopped)|%Vd(stopped)>>|%Vd(pane)%?nP<%Vd(collage)%Vd(photocount)|%Vd(nophotos)%Vd(photocaption)>|%?C<%Vd(a)|%Vd(pane)%Vd(note)%?mp<%Vd(stopped)|%Vd(normal)|%Vd(normal)|%Vd(normal)|%Vd(normal)|%Vd(normal)|%Vd(normal)|%Vd(stopped)|%Vd(stopped)>>>>
# the music: the song's cover, or the note and under it the library's count
# or the track. The cover fills the pane, nothing over it, as on the Video: Finder's 176
# px, its middle 110 columns. It is drawn from 33 columns before the pane,
# which are the menu's and its bar's, drawn after it
%Cl(0,0,176,176,c,c)
%Vl(a,77,0,143,176,-)
%Cd
%Vl(a,77,0,33,176,-)%Vb(000000)
# the lists: under the status bar, rows of 22; beside the pane 110 wide
%Vi(wide,0,19,220,157,1)%Vf(FFFFFF)%Vb(000000)
%Vi(half,0,19,110,157,1)%Vf(FFFFFF)%Vb(000000)
# the status bar across every screen: its ground, the hairline under it, the
# clock, the title in the middle, the glyphs; in the main menu the clock
# alone
%Vl(bar,0,0,220,16,-)%Vb(101010)
%Vl(rule,0,16,220,1,-)%Vb(202429)
%Vl(barh,0,0,110,16,-)%Vb(101010)
%Vl(ruleh,0,16,110,1,-)%Vb(202429)
%Vl(clock,9,1,44,14,2)%Vf(FFFFFF)%Vb(101010)
%al%?cf<%cH:%cM|%cl:%cM>
# a menu's title, which takes the clock's place too if it is wider (long_title())
%Vl(title,60,1,100,14,2)%Vf(FFFFFF)%Vb(101010)
%ac%Lt
%Vl(longm,9,1,140,14,2)%Vf(FFFFFF)%Vb(101010)
%al%nx%Lt
%Vl(longp,9,1,155,14,2)%Vf(FFFFFF)%Vb(101010)
%al%nx%Lt
%Vl(long,9,1,173,14,2)%Vf(FFFFFF)%Vb(101010)
%al%nx%Lt
%Vl(bat,187,3,24,10,-)%Vb(101010)
%?bp<%?bc<%t(1.0)%xd(Ba);%t(1.0)%xd(Bb)|%xd(Bc)>|%?bl<%xd(Bd)|%xd(Bd)|%xd(Be)|%xd(Bf)|%xd(Bg)|%xd(Bh)|%xd(Bi)|%xd(Bj)|%xd(Bk)|%xd(Bl)|%xd(Bm)|%xd(Bn)|%xd(Bo)|%xd(Bp)|%xd(Bq)|%xd(Br)|%xd(Bs)|%xd(Bt)|%xd(Bu)|%xd(Bv)|%xd(Bw)|%xd(Bx)|%xd(Bx)|%xd(Bx)>>
%Vl(play,169,3,10,10,-)%Vb(101010)
%?mh<%xd(H)|%?mp<|%xd(Pa)|%xd(Pb)|%xd(Pc)|%xd(Pd)>>
%Vl(moon,154,3,10,10,-)%Vb(101010)
%xd(N)
%Vl(bath,78,3,24,10,-)%Vb(101010)
%?bp<%?bc<%t(1.0)%xd(Ba);%t(1.0)%xd(Bb)|%xd(Bc)>|%?bl<%xd(Bd)|%xd(Bd)|%xd(Be)|%xd(Bf)|%xd(Bg)|%xd(Bh)|%xd(Bi)|%xd(Bj)|%xd(Bk)|%xd(Bl)|%xd(Bm)|%xd(Bn)|%xd(Bo)|%xd(Bp)|%xd(Bq)|%xd(Br)|%xd(Bs)|%xd(Bt)|%xd(Bu)|%xd(Bv)|%xd(Bw)|%xd(Bx)|%xd(Bx)|%xd(Bx)>>
%Vl(playh,60,3,10,10,-)%Vb(101010)
%?mh<%xd(H)|%?mp<|%xd(Pa)|%xd(Pb)|%xd(Pc)|%xd(Pd)>>
%Vl(moonh,45,3,10,10,-)%Vb(101010)
%xd(N)
# the pane, under all but a cover: a surface, and a hairline at its left
# (below, after the collage, which would clear it)
%Vl(pane,110,0,110,176,-)%Vb(000000)
# Settings: the disk's use as a ring of 64 px (neo_ring.h), the used part
# in the accent on a track of the theme's (apps/gui/ui_theme.c); what is free,
# and the whole, one block in the middle of the pane
%Vl(ring,133,36,64,64,-)%Vf(FF345A)%Vb(000000)
%nR
%Vl(about,113,110,104,14,2)%Vf(FFFFFF)%Vb(000000)
%s%ac%nf
%Vl(about,113,126,104,14,3)%Vf(B4B6BD)%Vb(000000)
%ac%nT
# Photos: four rows of three of them, made at Updating Library
# (photos_panel.c), round and between which the pane shows, and their count
# under them; without any, their mark and "No Photos"
%Vl(collage,110,12,110,132,-)%Vb(000000)
%xl(Q,/.rockbox/photos_panel.bmp,0,0)
%xd(Q)
%Vl(photocount,113,150,104,14,3)%Vf(B4B6BD)%Vb(000000)
%s%ac%nP
%xl(I,Photos Pane.bmp,0,0)
%Vl(nophotos,137,53,56,44,-)%Vb(000000)
%xd(I)
%Vl(photocaption,113,109,104,14,3)%Vf(B4B6BD)%Vb(000000)
%ac%nP
%Vl(pane,110,0,1,176,-)%Vb(181818)
# the music without a cover: the note and its caption, one block in the
# middle of the pane's height, the caption's capitals 8 rows under
# the note
%xl(O,Note Pane.bmp,0,0)
%Vl(note,123,38,84,84,-)%Vb(000000)
%xd(O)
%Vl(stopped,116,127,98,14,3)%Vf(B4B6BD)%Vb(000000)
%ac%ns
%Vl(normal,116,127,98,14,2)%Vf(FFFFFF)%Vb(000000)
%s%ac%?it<%it|%?fn<%fn|>>
