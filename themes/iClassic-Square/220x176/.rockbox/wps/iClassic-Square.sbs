# Theme: iClassic Square
# By: Humberto Santana (humbertosantana@hotmail.com)
# License: Creative Commons Attribution-Share Alike 3.0 (http://creativecommons.org/licenses/by-sa/3.0/)
# A few elements derived from iLike Theme for 320x240 by Alan Brito, which was ported from the 176x132 version by H. Pearce
# If used for other works, as per this license, please include the following Attribution Text: "Modified/Derived from iClassic Square theme for iPod Video (CC-BY-SA 3.0) by Humberto Santana"
#
# The iPod photo's 220x176 screen: RockWheel's 320x240 skin of the same name
# (themes/iClassic-Square/.rockbox/wps) laid out for it, with the same pictures
# at their own sizes (themes/tools/make_classic_220x176.py). The pane is beside
# the main menu alone and shows by the row selected, as on the Video: the iPod
# and its disk for Settings and Extras, the photos for Photos, the music for
# the rest; every other list takes the screen's width, as does the main menu
# with Cover Beside Menu off (the firmware's %LW).
#
# SBS File
#
%wd
%Fl(2,14-Inter-SemiBold.fnt,512)
%Fl(3,14-Inter-Bold.fnt,512)
%?LW<%VI(wide)%?St(battery percentage)<%?nN<%Vd(ptitlen)%Vd(pnight)|%Vd(ptitle)>%Vd(bat)%Vd(ppct)%Vd(pplay)|%?nN<%Vd(titlen)%Vd(night)|%Vd(title)>%Vd(bat)%Vd(play)>|%VI(half)%?St(battery percentage)<%?nN<%Vd(tn)|%Vd(pt)>%?mh<%Vd(phhold)|%?nN<%Vd(phnight)|%Vd(phpct)>>%Vd(hbat)|%?nN<%Vd(tn)%Vd(hnight)|%Vd(t)>%Vd(hbat)%Vd(hplay)>>
# beside the main menu, its pane by the row selected: Settings or Extras, the
# iPod and its disk; Photos, their collage; the rest, the song's cover, or
# the note in the backdrop and under it the library's count or the track
%?LW<|%?LS<%Vd(about)%Vd(name)|%Vd(about)%Vd(name)|%?nP<%Vd(collage)%Vd(photocount)|%Vd(nophotos)%Vd(photocaption)>|%?C<%Vd(a)|%?mp<%Vd(stopped)|%Vd(normal)|%Vd(normal)|%Vd(normal)|%Vd(normal)|%Vd(normal)|%Vd(normal)|%Vd(stopped)|%Vd(stopped)>>>>
# the cover fills the pane, as on the Video: Finder's 176 px, its middle 110
# columns. It is drawn from 33 columns before the pane, which are the menu's,
# drawn after it
%Cl(0,0,176,176,c,c)
%Vl(a,77,0,143,176,-)
%Cd
%Vl(a,77,0,33,176,-)
# the lists, under the status bar: half the width beside the pane, or a
# screen that takes it all, which has the Wide Backdrop
%Vi(wide,0,16,220,160,1)%Vf(000000)%Vb(FFFFFF)
%Vi(half,0,16,110,160,1)%Vf(000000)%Vb(FFFFFF)
%XW(Wide Backdrop.bmp)
# Settings or Extras selected in the main menu: the iPod and its disk, as on a stock iPod
%XS(About Backdrop.bmp)
# the title of the list; in the main menu the time; shorter beside the moon
# of Night Mode, and beside the pane
%Vl(title,6,1,161,14,3)%Vf(000000)
%al%?if(%Li, =, 33)<%?cf<%cH:%cM|%cl:%cM>|%s%Lt>
%Vl(titlen,6,1,144,14,3)%Vf(000000)
%al%?if(%Li, =, 33)<%?cf<%cH:%cM|%cl:%cM>|%s%Lt>
%Vl(t,6,1,60,14,3)%Vf(000000)
%al%?if(%Li, =, 33)<%?cf<%cH:%cM|%cl:%cM>|%s%Lt>
%Vl(tn,6,1,44,14,3)%Vf(000000)
%al%?if(%Li, =, 33)<%?cf<%cH:%cM|%cl:%cM>|%s%Lt>
# with Battery Percentage: the titles shorter by the level's box and its gap
%Vl(ptitle,6,1,126,14,3)%Vf(000000)
%al%?if(%Li, =, 33)<%?cf<%cH:%cM|%cl:%cM>|%s%Lt>
%Vl(ptitlen,6,1,109,14,3)%Vf(000000)
%al%?if(%Li, =, 33)<%?cf<%cH:%cM|%cl:%cM>|%s%Lt>
%Vl(pt,6,1,39,14,3)%Vf(000000)
%al%?if(%Li, =, 33)<%?cf<%cH:%cM|%cl:%cM>|%s%Lt>
%xl(N,Status Night.bmp,0,0)
%Vl(night,154,1,16,16,-)
%xd(N)
%Vl(hnight,52,1,16,16,-)
%xd(N)
%Vl(pnight,119,1,16,16,-)
%xd(N)
%Vl(phnight,68,1,16,16,-)
%xd(N)
%xl(B,Battery.bmp,0,0,24)
%Vl(bat,191,3,25,11,-)
%?bp<%?bc<%t(1.0)%xd(Ba);%t(1.0)%xd(Bb)|%xd(Bc)>|%?bl<%xd(Bd)|%xd(Bd)|%xd(Be)|%xd(Bf)|%xd(Bg)|%xd(Bh)|%xd(Bi)|%xd(Bj)|%xd(Bk)|%xd(Bl)|%xd(Bm)|%xd(Bn)|%xd(Bo)|%xd(Bp)|%xd(Bq)|%xd(Br)|%xd(Bs)|%xd(Bt)|%xd(Bu)|%xd(Bv)|%xd(Bw)|%xd(Bx)|%xd(Bx)|%xd(Bx)>>
%Vl(ppct,155,1,32,14,3)%Vf(000000)
%aR%?bl<|%bl%%>
%Vl(phpct,48,1,32,14,3)%Vf(000000)
%aR%?bl<|%bl%%>
%Vl(hbat,84,3,25,11,-)
%?bp<%?bc<%t(1.0)%xd(Ba);%t(1.0)%xd(Bb)|%xd(Bc)>|%?bl<%xd(Bd)|%xd(Bd)|%xd(Be)|%xd(Bf)|%xd(Bg)|%xd(Bh)|%xd(Bi)|%xd(Bj)|%xd(Bk)|%xd(Bl)|%xd(Bm)|%xd(Bn)|%xd(Bo)|%xd(Bp)|%xd(Bq)|%xd(Br)|%xd(Bs)|%xd(Bt)|%xd(Bu)|%xd(Bv)|%xd(Bw)|%xd(Bx)|%xd(Bx)|%xd(Bx)>>
%xl(h,Hold Icon.bmp,0,1)
%xl(P,Playing Status.bmp,0,0,4)
# in Classic's colour, if it has one other than its blue
%xA(P)
%Vl(play,171,2,16,13,-)
%?mh<%xd(h)|%?mp<|%xd(Pa)|%xd(Pb)|%xd(Pc)|%xd(Pd)|%xd(Pa)|%xd(Pb)|%xd(Pa)|%xd(Pb)>>
%Vl(hplay,68,2,16,13,-)
%?mh<%xd(h)|%?mp<|%xd(Pa)|%xd(Pb)|%xd(Pc)|%xd(Pd)|%xd(Pa)|%xd(Pb)|%xd(Pa)|%xd(Pb)>>
%Vl(pplay,136,2,16,13,-)
%?mh<%xd(h)|%?mp<|%xd(Pa)|%xd(Pb)|%xd(Pc)|%xd(Pd)|%xd(Pa)|%xd(Pb)|%xd(Pa)|%xd(Pb)>>
# beside the pane with Battery Percentage: Hold's padlock in the level's place
%Vl(phhold,68,2,16,13,-)
%xd(h)
# nothing playing: the library under the note, as on a stock iPod; a track
# without a cover: its title, artist and album, as on the Video
%Vl(stopped,113,112,104,20,1)%Vf(ebeced)
%ac%ns
%Vl(normal,113,112,104,20,1)%Vf(ebeced)
%t(6)%s%ac%?it<%it|%?fn<%fn|>>;%t(12)%ac%?it<%it|%?fn<%fn|>>
%Vl(normal,113,133,104,16,2)%Vf(ebeced)
%t(6)%ac%?fn<%?ia<%ia|%?iA<%iA|%Sx(Unknown Artist)>>|>;%t(6)%s%ac%?fn<%?ia<%ia|%?iA<%iA|%Sx(Unknown Artist)>>|>;%t(6)%ac%?fn<%?ia<%ia|%?iA<%iA|%Sx(Unknown Artist)>>|>
%Vl(normal,113,149,104,16,2)%Vf(ebeced)
%t(12)%ac%?fn<%?id<%id|%Sx(Unknown Album)>|>;%t(6)%s%ac%?fn<%?id<%id|%Sx(Unknown Album)>|>
# Settings or Extras: the name given in Finder, in whole letters and an
# ellipsis if it is wider than the pane; the disk's use in the backdrop's
# trough (make_classic_220x176.py) and what is free
%Vl(about,110,0,110,176,-)
%nu(11,128,94,8,Disk Fill.bmp)
%Vl(name,111,10,108,16,3)%Vf(dde1e6)
%ac%ne
%Vl(about,113,141,104,20,1)%Vf(eceef0)
%s%ac%nf
# Photos: four rows of three of them, made at Updating Library
# (photos_panel.c), and their count under them; without any, their icon over
# the note and "No Photos"
%Vl(collage,110,12,110,132,-)
%xl(Q,/.rockbox/photos_panel.bmp,0,0)
%xd(Q)
%Vl(photocount,113,148,104,20,1)%Vf(eceef0)
%s%ac%nP
%Vl(nophotos,110,24,110,80,-)
%xl(I,Photos Icon.bmp,0,0)
%xd(I)
%Vl(photocaption,113,112,104,20,1)%Vf(ebeced)
%ac%nP
