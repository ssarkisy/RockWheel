  user: core
  <source>
    *: "In Albums, Shuffle Songs plays your whole library, as in the main menu."
  </source>
  <dest>
    *: "W Albumy Tasuj utwory odtwarza całą bibliotekę, jak w menu głównym."
  </dest>
  <voice>
    *: ""
  </voice>
</phrase>
