<phrase>
  id: LANG_CONFIRM_WITH_BUTTON
  desc: Generic string to use to confirm
  user: core
  <source>
    *: "PLAY = Yes"
    archosplayer: "(PLAY/STOP)"
    cowond2*: "MENU, or top-right = Yes"
    gigabeat*,iaudiom5,iaudiox5,ipod*,iriverh10,iriverh10_5gb,mrobe100,sansac200*,sansaclip*,sansaconnect,sansae200*,sansafuze*: "SELECT = Yes"
    iriverh100,iriverh120,iriverh300: "NAVI = Yes"
    mrobe500: "PLAY, POWER, or top-right = Yes"
    vibe500: "OK = Yes"
  </source>
  <dest>
    *: "כן = PLAY"
    archosplayer: "(PLAY/STOP)"
    cowond2*: "או פינה ימנית-עליונה = כן MENU"
    gigabeat*,iaudiom5,iaudiox5,ipod*,iriverh10,iriverh10_5gb,mrobe100,sansac200*,sansaclip*,sansae200*,sansafuze*: "כן = SELECT"
    iriverh100,iriverh120,iriverh300: "כן = NAVI"
    mrobe500: "או פינה ימנית-עליונה = כן Power, Play"
    vibe500: "כן = OK"
  </dest>
  <voice>
    *: ""
  </voice>
</phrase>
