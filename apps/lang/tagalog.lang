    iriverh100,iriverh120,iriverh300: "NAVI = Oo"
    mrobe500: "PLAY, POWER, or top-right = Oo"
    vibe500: "OK = Oo"
  </dest>
  <voice>
    *: ""
  </voice>
</phrase>
